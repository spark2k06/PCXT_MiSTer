# pc_common: EGA core and its SDRAM frontend (vendor/pc_common/README.md).
# The packages go first. vram_fetch, vid_mux and sdram_pkg belong to the core's
# memory subsystem (rtl/mem/mem.qip) and have to be in the project as well.
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) ega/ega_vram_fns_pkg.sv]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/UM6845R.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_attrib_ctrl.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_ddr_arbiter.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_dot_clock.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_fb_capture.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_fb_readout.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_gfx_ctrl.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_monitor_profile_latch.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_pixel.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_sequencer.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_switch_sense.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_text.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_top.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/ega_vgaport.v]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) ega/video_monochrome_converter.sv]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) ega/video_scandoubler.v]
